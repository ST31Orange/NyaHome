{
	"name": "nyahome",
	"version": "4.0.2",
	"description": "Obsidian plugin: NyaHome unified workspace with local calendars and optional connected calendar/mail services",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "esbuild tests/tests.ts --bundle --format=cjs --outfile=tests.cjs && node tests.cjs",
		"deploy": "npm run build && node deploy.mjs"
	},
	"dependencies": {
		"ical.js": "2.2.1",
		"imapflow": "^2.0.5",
		"mailparser": "^3.9.28",
		"nodemailer": "^10.0.10",
		"solarlunar": "^3.1.0"
	},
	"devDependencies": {
		"@types/mailparser": "^3.4.6",
		"@types/node": "20.19.43",
		"@types/nodemailer": "^8.0.2",
		"esbuild": "0.21.5",
		"obsidian": "1.13.1",
		"tslib": "2.8.1",
		"typescript": "5.9.3"
	}
}
